POSTGRES_DB=link_vault_db
POSTGRES_USER=linkvault
POSTGRES_PASSWORD=change-me

PGADMIN_EMAIL=admin@linkvault.dev
PGADMIN_PASSWORD=change-me

APP_JWT_ISSUER=link-vault-api
APP_JWT_SECRET=change-this-secret-to-a-long-random-string-at-least-32-chars
APP_JWT_EXPIRATION_MINUTES=120
APP_SEED_DEMO_DATA=false
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

REDIS_PASSWORD=change-me-redis
REDIS_DATABASE=0
REDIS_TIMEOUT=2s
APP_REDIS_ENABLED=true
APP_REDIS_KEY_PREFIX=linkvault
APP_REDIS_RATE_LIMIT_ENABLED=true
APP_REDIS_CACHE_DASHBOARD_SUMMARY_TTL=5m
APP_REDIS_CACHE_VAULT_LIST_TTL=10m
APP_REDIS_CACHE_FOLDER_TREE_TTL=10m
APP_REDIS_CACHE_RESOURCE_LIST_TTL=3m
APP_REDIS_CACHE_RESOURCE_DETAIL_TTL=5m
APP_REDIS_CACHE_TAG_LIST_TTL=10m
APP_REDIS_CACHE_WORKSPACE_USAGE_TTL=1m
APP_REDIS_CACHE_LINK_PREVIEW_TTL=30m
APP_REDIS_RATE_LIMIT_AUTH_CAPACITY=10
APP_REDIS_RATE_LIMIT_AUTH_WINDOW=1m
APP_REDIS_RATE_LIMIT_UPLOAD_CAPACITY=20
APP_REDIS_RATE_LIMIT_UPLOAD_WINDOW=1m
APP_REDIS_RATE_LIMIT_PREVIEW_CAPACITY=50
APP_REDIS_RATE_LIMIT_PREVIEW_WINDOW=1m

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=link-vault
CLOUDINARY_USE_SECURE_URL=true
CLOUDINARY_MAX_FILE_SIZE_MB=20
CLOUDINARY_ALLOWED_FORMATS=jpg,jpeg,png,webp,gif,svg,pdf,doc,docx,xls,xlsx,ppt,pptx,txt,md,csv,json,xml,yaml,yml,log,java,kt,py,ts,tsx,js,jsx,html,css,scss,sql,sh,ps1,c,cpp,h,hpp,cs,go,rs,php,rb,swift,dart,zip,rar,7z,mp3,wav,mp4,webm,mov


RABBITMQ_DEFAULT_USER=linkvault
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq
RABBITMQ_DEFAULT_VHOST=/

APP_RABBITMQ_ENABLED=true
APP_RABBITMQ_EXCHANGE=linkvault.events.exchange

APP_RABBITMQ_AUDIT_QUEUE=linkvault.audit.queue
APP_RABBITMQ_PREVIEW_QUEUE=linkvault.preview.queue
APP_RABBITMQ_NOTIFICATION_QUEUE=linkvault.notification.queue
APP_RABBITMQ_CLEANUP_QUEUE=linkvault.cleanup.queue

APP_RABBITMQ_AUDIT_ROUTING_KEY=linkvault.audit.record
APP_RABBITMQ_PREVIEW_ROUTING_KEY=linkvault.resource.preview.requested
APP_RABBITMQ_NOTIFICATION_ROUTING_KEY=linkvault.notification.requested
APP_RABBITMQ_CLEANUP_ROUTING_KEY=linkvault.cleanup.requested

APP_RABBITMQ_RETRY_MAX_ATTEMPTS=3
APP_RABBITMQ_RETRY_INITIAL_INTERVAL=1000
APP_RABBITMQ_RETRY_MULTIPLIER=2.0
APP_RABBITMQ_RETRY_MAX_INTERVAL=10000
