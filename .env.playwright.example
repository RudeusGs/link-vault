# URL frontend đang chạy
E2E_BASE_URL=http://127.0.0.1:4200

# Có thể để trống nếu tự chạy frontend trước khi test.
# Angular CLI ví dụ:
E2E_START_COMMAND=npm start -- --host 127.0.0.1 --port 4200

# URL backend cho API smoke test. Để trống thì test health sẽ được skip.
E2E_API_URL=http://127.0.0.1:8080

# Tài khoản test thật. Để trống thì case đăng nhập thành công sẽ được skip.
E2E_USERNAME=
E2E_PASSWORD=

# Key localStorage của dự án. Sửa nếu dự án đang dùng key khác.
E2E_AUTH_STORAGE_KEY=token
E2E_USER_STORAGE_KEY=currentUser
E2E_FAKE_TOKEN=e2e.mock.jwt.token

# true để chạy thêm Firefox và WebKit. Mặc định chỉ Chromium để chạy nhanh.
E2E_ALL_BROWSERS=false
